# ──────────────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno. Copiar a `.env` para desarrollo local o
# a `/opt/inio-bim/.env` en la VM de producción y rellenar valores reales.
# ──────────────────────────────────────────────────────────────────────────────

# ── Común ─────────────────────────────────────────────────────────────────────
# Generar con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# Qué módulo de settings usar. Local: config.settings.local | Prod: config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.local

# ── Solo producción ───────────────────────────────────────────────────────────
# Hosts permitidos separados por coma (sin http://). Puede ser IP o dominio.
ALLOWED_HOSTS=20.1.2.3

# URL a Postgres. Formatos:
#   Postgres local en la VM:  postgres://inioadmin:PASSWORD@127.0.0.1:5432/biminiodb
#   Azure DB (managed):        postgres://inioadmin:PASSWORD@psql-inio-bim.postgres.database.azure.com:5432/biminiodb?sslmode=require
DATABASE_URL=postgres://inioadmin:PASSWORD@127.0.0.1:5432/biminiodb

# Orígenes permitidos para CORS y CSRF (con esquema, sin trailing slash).
# Si accedes por IP sin dominio: http://20.1.2.3
CORS_ALLOWED_ORIGINS=http://20.1.2.3

# Activar SSL redirect + HSTS + secure cookies. Ponlo en True SOLO cuando Nginx
# ya sirva HTTPS (certbot). Antes de eso, déjalo en False.
USE_HTTPS=False

# ── Media storage ─────────────────────────────────────────────────────────────
# Si comentas las 3 variables AZURE_*, Django usa filesystem local (MEDIA_ROOT).
# Si las defines, usa Azure Blob Storage.

# --- Opción A: filesystem local (default) ---
# MEDIA_ROOT=/opt/inio-bim/media

# --- Opción B: Azure Blob ---
# AZURE_ACCOUNT_NAME=stinioibim
# AZURE_ACCOUNT_KEY=paste-key-from-azure-portal
# AZURE_MEDIA_CONTAINER=bim-media
